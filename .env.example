# Copy to .env and fill in. .env is gitignored — never commit it.
#
# IMPORTANT, and easy to get wrong: your AI keys and mailbox password do NOT go in
# this file. They live in n8n's own Credentials store, because that is where the
# workflows read them from. See docs/workflows-reference.md for the seven
# credentials to create and their exact names.
#
# This file is only for the things that run OUTSIDE n8n: the helper scripts in
# scripts/, the evals in evals/, and the optional local Docker stack.
#
# You can run the whole platform with nothing in here at all — it is needed only if
# you use those scripts.


# ─── Talking to your n8n from the scripts ────────────────────────────────────
# Needed by: scripts/sync-workflows.js
# Get the key from n8n: Settings → n8n API → Create API key.
# For hosted n8n the URL is your instance, e.g. https://you.app.n8n.cloud
N8N_API_URL=http://localhost:5678
N8N_API_KEY=paste-your-n8n-api-key-here


# ─── Reaching your database from the scripts ─────────────────────────────────
# Two ways; pick whichever matches where Postgres lives.
#
# (a) HOSTED Postgres (Supabase, Neon, RDS…). Set this and the container settings
#     below are ignored. Supabase: Project Settings → Database → connection string.
# DATABASE_URL=postgresql://user:password@host:5432/salesgenie

# (b) LOCAL Postgres in Docker. POSTGRES_CONTAINER is the container name — find it
#     with `docker ps`. Do set it: if you leave it out, the scripts fall back to the
#     author's own container name, which will not exist on your machine.
#     `salesgenie-postgres` is what docker/docker-compose.yml creates.
#     Running a throwaway stack beside a live one? Pass CONTAINER_PREFIX to compose
#     (e.g. CONTAINER_PREFIX=sg-test) and set this to match, or both stacks collide.
POSTGRES_CONTAINER=salesgenie-postgres
POSTGRES_USER=salesgenie
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=salesgenie


# ─── MCP (the chat interface) ────────────────────────────────────────────────
# Invent a long random string; generate one with: openssl rand -hex 24
# The SAME value goes into the n8n credential `Capstone-MCP-Bearer`, and into your
# chat client's config as the bearer token. Skip if you will not use chat control.
MCP_BEARER_TOKEN=generate-with-openssl-rand-hex-24


# ─── A2A demo client (optional) ──────────────────────────────────────────────
# Only for scripts/buyer-agent-demo.js, which plays another company's buying agent.
# This token is a DIFFERENT secret from the MCP one above: it must exactly match the
# `a2a_bearer` row you inserted into vaibhavcapstone_platform_config in Step 1 of
# docs/business-onboarding-guide.md. Look it up any time with:
#   SELECT value FROM vaibhavcapstone_platform_config WHERE key = 'a2a_bearer';
# A2A_BEARER_TOKEN=the-same-phrase-you-put-in-the-a2a_bearer-row
# A2A_BASE_URL=https://you.app.n8n.cloud/webhook
# A2A_BUSINESS_ID=biz_yourbusiness


# ─── Optional local Langfuse (LLM tracing) ───────────────────────────────────
# ONLY needed if you run docker/langfuse-compose.yml yourself. Most people should
# use the free hosted tier at cloud.langfuse.com instead — then you need none of
# these, just the `Capstone-Langfuse` credential in n8n.
#
# Langfuse joins the SAME docker network as your postgres container, because it
# reaches it as the hostname `postgres`. The default assumes you started
# docker/docker-compose.yml from the docker/ folder, which names the network
# `docker_default`. Anything else — a different folder name, `-p`, or your own n8n
# stack — and you must set this. Find the real name with:  docker network ls
# N8N_DOCKER_NETWORK=docker_default
# Generate each secret with: openssl rand -hex 32
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_INIT_USER_EMAIL=you@example.com
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
