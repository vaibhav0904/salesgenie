# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# n8n API key: n8n UI (http://localhost:5678) -> Settings -> n8n API -> Create API key
N8N_API_URL=http://localhost:5678
N8N_API_KEY=paste-your-n8n-api-key-here

# Postgres (added to the n8n docker-compose in E1-S1; choose any strong password)
POSTGRES_USER=salesgenie
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=salesgenie

# Future keys go below (never in code, workflows, or committed files)

# MCP Server Trigger bearer token
MCP_BEARER_TOKEN=generate-with-openssl-rand-hex-24
